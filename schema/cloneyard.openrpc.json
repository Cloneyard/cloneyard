{
  "openrpc": "1.4.1",
  "info": {
    "title": "Cloneyard",
    "version": "0.0.1"
  },
  "methods": [
    {
      "name": "system.ping",
      "summary": "Returns the node id, to check that the daemon answers",
      "params": [],
      "result": {
        "name": "PingResult",
        "schema": {
          "$ref": "#/components/schemas/PingResult"
        }
      }
    },
    {
      "name": "system.version",
      "summary": "Returns the version of the daemon",
      "params": [],
      "result": {
        "name": "VersionResult",
        "schema": {
          "$ref": "#/components/schemas/VersionResult"
        }
      }
    },
    {
      "name": "rpc.discover",
      "description": "Returns an OpenRPC schema as a description of this service",
      "params": [],
      "result": {
        "name": "OpenRPC Schema",
        "schema": {
          "$ref": "https://raw.githubusercontent.com/open-rpc/meta-schema/master/schema.json"
        }
      }
    },
    {
      "name": "project.add",
      "summary": "Adds the git repo at a path as a project with that one repo",
      "params": [
        {
          "name": "name",
          "schema": {
            "description": "The name of the project, or the name of the repo's directory when left out.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        {
          "name": "path",
          "required": true,
          "schema": {
            "description": "An absolute path in the repo's working tree, such as its top level or a directory inside it.",
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "Project",
        "schema": {
          "$ref": "#/components/schemas/Project"
        }
      },
      "errors": [
        {
          "code": 1000,
          "message": "Path is not absolute",
          "data": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          }
        },
        {
          "code": 1001,
          "message": "Path is not in a git working tree",
          "data": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          }
        },
        {
          "code": 1002,
          "message": "Repo is already in a project",
          "data": {
            "type": "object",
            "properties": {
              "path": {
                "description": "The top level of the repo.",
                "type": "string"
              },
              "project": {
                "description": "The name of the project the repo is in.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "project"
            ]
          }
        },
        {
          "code": 1003,
          "message": "Project name is taken",
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      ],
      "paramStructure": "by-name"
    },
    {
      "name": "project.list",
      "summary": "Returns the projects with their repos on this node",
      "params": [],
      "result": {
        "name": "ListResult",
        "schema": {
          "$ref": "#/components/schemas/ListResult"
        }
      }
    },
    {
      "name": "account.add",
      "summary": "Adds an account that is logged in to its provider in a directory on this node",
      "params": [
        {
          "name": "dir",
          "required": true,
          "schema": {
            "description": "The absolute path of the directory that holds the account's login on this node.",
            "type": "string"
          }
        },
        {
          "name": "name",
          "required": true,
          "schema": {
            "description": "The name of the account.",
            "type": "string"
          }
        },
        {
          "name": "provider",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Provider"
          }
        }
      ],
      "result": {
        "name": "Account",
        "schema": {
          "$ref": "#/components/schemas/Account"
        }
      },
      "errors": [
        {
          "code": 1100,
          "message": "Directory is not an absolute path",
          "data": {
            "type": "object",
            "properties": {
              "dir": {
                "type": "string"
              }
            },
            "required": [
              "dir"
            ]
          }
        },
        {
          "code": 1101,
          "message": "Path is not a directory",
          "data": {
            "type": "object",
            "properties": {
              "dir": {
                "type": "string"
              }
            },
            "required": [
              "dir"
            ]
          }
        },
        {
          "code": 1102,
          "message": "Directory belongs to another account",
          "data": {
            "type": "object",
            "properties": {
              "account": {
                "description": "The name of the account that has the directory.",
                "type": "string"
              },
              "dir": {
                "description": "The directory with symlinks resolved.",
                "type": "string"
              }
            },
            "required": [
              "dir",
              "account"
            ]
          }
        },
        {
          "code": 1103,
          "message": "Account name is taken",
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      ],
      "paramStructure": "by-name"
    },
    {
      "name": "account.list",
      "summary": "Returns the accounts with their directories on this node",
      "params": [],
      "result": {
        "name": "AccountListResult",
        "schema": {
          "$ref": "#/components/schemas/AccountListResult"
        }
      }
    },
    {
      "name": "clone.run",
      "summary": "Starts a headless clone on an account, in a checkout of a project's repo",
      "params": [
        {
          "name": "account",
          "required": true,
          "schema": {
            "description": "The name of the account the clone runs on.",
            "type": "string"
          }
        },
        {
          "name": "project",
          "required": true,
          "schema": {
            "description": "The name of the project whose repo the clone gets a checkout of.",
            "type": "string"
          }
        },
        {
          "name": "prompt",
          "required": true,
          "schema": {
            "description": "The first message to the clone.",
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "Clone",
        "schema": {
          "$ref": "#/components/schemas/Clone"
        }
      },
      "errors": [
        {
          "code": 1200,
          "message": "No such project",
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "code": 1201,
          "message": "No such account",
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "code": 1204,
          "message": "No sandbox for clones on this node",
          "data": {
            "type": "object",
            "properties": {
              "config": {
                "type": "string"
              }
            },
            "required": [
              "config"
            ]
          }
        }
      ],
      "paramStructure": "by-name"
    },
    {
      "name": "clone.list",
      "summary": "Returns the clones on this node",
      "params": [],
      "result": {
        "name": "CloneListResult",
        "schema": {
          "$ref": "#/components/schemas/CloneListResult"
        }
      }
    },
    {
      "name": "clone.show",
      "summary": "Returns a clone by its handle",
      "params": [
        {
          "name": "handle",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Handle"
          }
        }
      ],
      "result": {
        "name": "Clone",
        "schema": {
          "$ref": "#/components/schemas/Clone"
        }
      },
      "errors": [
        {
          "code": 1202,
          "message": "No such clone",
          "data": {
            "type": "object",
            "properties": {
              "handle": {
                "$ref": "#/components/schemas/Handle"
              }
            },
            "required": [
              "handle"
            ]
          }
        }
      ],
      "paramStructure": "by-name"
    },
    {
      "name": "clone.stop",
      "summary": "Ends a clone's process and returns the clone once it has ended",
      "params": [
        {
          "name": "handle",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Handle"
          }
        }
      ],
      "result": {
        "name": "Clone",
        "schema": {
          "$ref": "#/components/schemas/Clone"
        }
      },
      "errors": [
        {
          "code": 1202,
          "message": "No such clone",
          "data": {
            "type": "object",
            "properties": {
              "handle": {
                "$ref": "#/components/schemas/Handle"
              }
            },
            "required": [
              "handle"
            ]
          }
        },
        {
          "code": 1203,
          "message": "Clone is not running",
          "data": {
            "type": "object",
            "properties": {
              "handle": {
                "$ref": "#/components/schemas/Handle"
              },
              "state": {
                "$ref": "#/components/schemas/State"
              }
            },
            "required": [
              "handle",
              "state"
            ]
          }
        }
      ],
      "paramStructure": "by-name"
    },
    {
      "name": "clone.events",
      "summary": "Returns a clone's last hook events, oldest first",
      "params": [
        {
          "name": "handle",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Handle"
          }
        },
        {
          "name": "limit",
          "required": true,
          "schema": {
            "description": "How many of the newest events to return.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      ],
      "result": {
        "name": "CloneEventsResult",
        "schema": {
          "$ref": "#/components/schemas/CloneEventsResult"
        }
      },
      "errors": [
        {
          "code": 1202,
          "message": "No such clone",
          "data": {
            "type": "object",
            "properties": {
              "handle": {
                "$ref": "#/components/schemas/Handle"
              }
            },
            "required": [
              "handle"
            ]
          }
        }
      ],
      "paramStructure": "by-name"
    },
    {
      "name": "usage.tools",
      "summary": "Returns the tool calls of the clones on this node since a point in time, per tool and what the calls were about",
      "params": [
        {
          "name": "project",
          "schema": {
            "description": "The name of the project whose clones count, or every project when left out.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        {
          "name": "since",
          "required": true,
          "schema": {
            "description": "The start of the period, in milliseconds since the Unix epoch.",
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "result": {
        "name": "UsageToolsResult",
        "schema": {
          "$ref": "#/components/schemas/UsageToolsResult"
        }
      },
      "errors": [
        {
          "code": 1300,
          "message": "No such project",
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      ],
      "paramStructure": "by-name"
    }
  ],
  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "dir": {
            "description": "The directory that holds the account's login on this node, or null when it has none here.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "name": {
            "description": "Unique among the accounts.",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          }
        },
        "required": [
          "id",
          "name",
          "provider"
        ],
        "type": "object"
      },
      "AccountListResult": {
        "properties": {
          "accounts": {
            "description": "Sorted by name.",
            "items": {
              "$ref": "#/components/schemas/Account"
            },
            "type": "array"
          }
        },
        "required": [
          "accounts"
        ],
        "type": "object"
      },
      "Clone": {
        "description": "A coding agent that Cloneyard runs on an account, in a checkout of its own.",
        "properties": {
          "account": {
            "description": "The name of the account the clone runs on.",
            "type": "string"
          },
          "branch": {
            "description": "The branch of the checkout, which is the clone's own.",
            "type": "string"
          },
          "checkout": {
            "description": "The path of the checkout on this node.",
            "type": "string"
          },
          "handle": {
            "$ref": "#/components/schemas/Handle"
          },
          "id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "project": {
            "description": "The name of the project whose repo the checkout is of.",
            "type": "string"
          },
          "reason": {
            "description": "Why the clone ended in `error`, or null in any other state.",
            "type": [
              "string",
              "null"
            ]
          },
          "sessions": {
            "description": "In the order they started.",
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "unsandboxed": {
            "description": "Whether the clone runs without the sandbox: when the node's settings say `unsandboxed = true`, and for every clone started before the sandbox existed.",
            "type": "boolean"
          },
          "usage": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Usage"
              }
            ],
            "description": "What its sessions took together."
          }
        },
        "required": [
          "id",
          "handle",
          "project",
          "account",
          "mode",
          "state",
          "branch",
          "checkout",
          "unsandboxed",
          "sessions",
          "usage"
        ],
        "type": "object"
      },
      "CloneEventsResult": {
        "properties": {
          "events": {
            "description": "Oldest first.",
            "items": {
              "$ref": "#/components/schemas/HookEvent"
            },
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "CloneListResult": {
        "properties": {
          "clones": {
            "description": "Sorted by handle.",
            "items": {
              "$ref": "#/components/schemas/Clone"
            },
            "type": "array"
          }
        },
        "required": [
          "clones"
        ],
        "type": "object"
      },
      "Handle": {
        "description": "A clone's short name on its node, such as `CT-0042`.",
        "pattern": "^CT-[0-9]{4,}$",
        "type": "string"
      },
      "HookEvent": {
        "description": "What one hook of a clone's provider reported, such as a tool call or the end of a turn.",
        "properties": {
          "at": {
            "description": "When the hook ran, in milliseconds since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "hook": {
            "description": "The provider's name of the hook, such as `PreToolUse`.",
            "type": "string"
          },
          "id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "session": {
            "description": "The provider's id of the session it ran in.",
            "type": "string"
          },
          "tool": {
            "description": "The tool of a tool hook, such as `Bash`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "at",
          "session",
          "hook"
        ],
        "type": "object"
      },
      "ListResult": {
        "properties": {
          "projects": {
            "description": "Sorted by name.",
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "type": "object"
      },
      "Mode": {
        "oneOf": [
          {
            "const": "headless",
            "description": "Runs without a terminal, from a prompt, and reports its state through its output.",
            "type": "string"
          }
        ]
      },
      "PingResult": {
        "properties": {
          "node_id": {
            "description": "The id of the node the daemon runs on.",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          }
        },
        "required": [
          "node_id"
        ],
        "type": "object"
      },
      "Project": {
        "properties": {
          "id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "name": {
            "description": "Unique among the projects.",
            "type": "string"
          },
          "repos": {
            "description": "The repos with a path on this node, sorted by name.",
            "items": {
              "$ref": "#/components/schemas/Repo"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "repos"
        ],
        "type": "object"
      },
      "Provider": {
        "description": "The coding agent CLI that an account logs in to.",
        "oneOf": [
          {
            "const": "claude-code",
            "description": "Claude Code, which keeps each login in a config directory of its own.",
            "type": "string"
          }
        ]
      },
      "Repo": {
        "properties": {
          "id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "name": {
            "description": "The name of the repo's directory, unique within its project.",
            "type": "string"
          },
          "path": {
            "description": "The top level of the repo's working tree on this node.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "path"
        ],
        "type": "object"
      },
      "Session": {
        "description": "One provider session of a clone.",
        "properties": {
          "id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "provider_id": {
            "description": "The provider's id of the session, such as Claude Code's `session_id`.",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "provider_id",
          "usage"
        ],
        "type": "object"
      },
      "State": {
        "oneOf": [
          {
            "const": "working",
            "description": "It works on its turn.",
            "type": "string"
          },
          {
            "const": "blocked",
            "description": "It waits for a permission.",
            "type": "string"
          },
          {
            "const": "idle",
            "description": "It ended its turn and waits for a message.",
            "type": "string"
          },
          {
            "const": "done",
            "description": "It ended its turn without an error.",
            "type": "string"
          },
          {
            "const": "error",
            "description": "It failed, or its process ended or was lost before its turn ended.",
            "type": "string"
          },
          {
            "const": "stopped",
            "description": "It was stopped on request.",
            "type": "string"
          }
        ]
      },
      "ToolUsage": {
        "description": "The calls of one tool about one command or path, or about anything when its tool doesn't say.",
        "properties": {
          "average_result_tokens": {
            "description": "The average size of their results in tokens, as bytes / 4, over the calls that report one; null when none does.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "calls": {
            "description": "The calls, the denied ones included.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "command": {
            "description": "What the commands start with, the program and its first argument unless that is an option or a path, such as `gh api`.",
            "type": [
              "string",
              "null"
            ]
          },
          "denials": {
            "description": "The calls that the clone's permissions denied.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "errors": {
            "description": "The calls that ran and failed.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "description": "The file that the calls read or changed, relative to the clone's checkout when it is inside it.",
            "type": [
              "string",
              "null"
            ]
          },
          "retries": {
            "description": "The calls whose previous call of the same tool and command or path in their session failed.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tool": {
            "description": "The provider's name of the tool, such as `Bash`.",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "calls",
          "errors",
          "retries",
          "denials"
        ],
        "type": "object"
      },
      "Usage": {
        "description": "The tokens and the cost of the requests to the model, as the provider's telemetry reports them.",
        "properties": {
          "cache_creation_tokens": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "cache_read_tokens": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "cost_usd_micros": {
            "description": "What the provider estimates the requests cost, in millionths of a US dollar; on a subscription, at API prices.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "input_tokens": {
            "description": "The input tokens that no cache served.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "output_tokens": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "input_tokens",
          "output_tokens",
          "cache_read_tokens",
          "cache_creation_tokens",
          "cost_usd_micros"
        ],
        "type": "object"
      },
      "UsageToolsResult": {
        "properties": {
          "tools": {
            "description": "Sorted by the bytes of their results in total, most first.",
            "items": {
              "$ref": "#/components/schemas/ToolUsage"
            },
            "type": "array"
          }
        },
        "required": [
          "tools"
        ],
        "type": "object"
      },
      "VersionResult": {
        "properties": {
          "version": {
            "description": "The version of the daemon, such as `0.0.1`.",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      }
    }
